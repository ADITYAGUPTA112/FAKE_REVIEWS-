{
  "manifest_version": 3,
  "name": "TrustLens Real-Time Badge",
  "version": "1.0.0",
  "description": "Shows Authentic vs Adjusted trust rating on Amazon/Flipkart product pages.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.amazon.in/*",
    "https://www.flipkart.com/*",
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.in/*",
        "https://www.flipkart.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "TrustLens",
    "default_popup": "popup.html"
  }
}
